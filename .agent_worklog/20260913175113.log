import json, re

path = "/root/.gemini/antigravity-cli/brain/bd8599a7-391a-46d9-8545-f76367aaf1d4/.system_generated/logs/transcript_full.jsonl"
steps = []
with open(path, "r", encoding="utf-8") as f:
    for line in f:
        if line.strip():
            steps.append(json.loads(line))

print("Total steps:", len(steps))

# Group by turns
turns = []
current_turn = None

for i, s in enumerate(steps):
    stype = s.get("type")
    if stype == "USER_INPUT":
        if current_turn is not None:
            turns.append(current_turn)
        current_turn = {
            "user_step": s,
            "step_index": i,
            "actions": [],
            "agent_response": ""
        }
    elif current_turn is not None:
        if "tool_calls" in s and s["tool_calls"]:
            for tc in s["tool_calls"]:
                current_turn["actions"].append(tc)
        if s.get("source") == "MODEL" and s.get("type") == "PLANNER_RESPONSE":
            content = s.get("content", "")
            if content and not s.get("tool_calls"):
                current_turn["agent_response"] = content
            elif content:
                # If there are tool calls and content, sometimes content is thought or pre-message
                pass

if current_turn is not None:
    turns.append(current_turn)

print("Parsed turns:", len(turns))
for t_idx, t in enumerate(turns, 1):
    u_content = t["user_step"].get("content", "")
    req_match = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", u_content, re.DOTALL)
    if req_match:
        prompt = req_match.group(1).strip()
    else:
        prompt = u_content.strip()
    print(f"Turn {t_idx}: Actions={len(t[\"actions\"])}, HasAgentResp={bool(t[\"agent_response\"])}, Prompt={prompt[:50]}")
