  const uploadCount = pendingFiles.length > 0 ? pendingFiles.length : selectedFiles.length;

  if (!isUploading) {
    btnUpload.disabled = false;
    btnUpload.innerText = uploadCount === 1 ? "Upload 1 File (PUT)" : `Upload ${uploadCount} Files (PUT)`;
