---

### 核心代码变更

```javascript
function addFiles(fileListInput) {
  if (isUploading) return;
  const newFiles = Array.from(fileListInput);
  const duplicates = [];

  for (const file of newFiles) {
    // 仅对比未完成上传（status !== "done"）的待处理文件，且仅按文件名 file.name 匹配
    const exists = selectedFiles.some(
      item => item.status !== "done" && item.file.name === file.name
    );
    if (exists) {
      duplicates.push(file.name);
    } else {
      selectedFiles.push({ file, status: "pending", pct: 0, target: "" });
    }
  }

  // 发现重复文件时显示错误提示信息
  if (duplicates.length > 0) {
    resultBox.className = "result-box error";
    resultBox.style.display = "block";
    const names = duplicates.map(n => `<code>${escapeHtml(n)}</code>`).join(", ");
    resultBox.innerHTML = `<strong>Duplicate file skipped:</strong> ${names} already waiting in upload queue.`;
  } else if (resultBox.classList.contains("error") && resultBox.innerHTML.includes("Duplicate file skipped")) {
    resultBox.style.display = "none";
  }

  renderFileList();
}
```

