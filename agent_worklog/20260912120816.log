const express = require("express");
const fs = require("fs");
const path = require("path");

const app = express();
const WORK_DIR = "/tmp/webterm_test_agy";
fs.mkdirSync(WORK_DIR, { recursive: true });

function resolveDownloadPath(rawPath, baseDir) {
  const cleanPath = path.normalize(rawPath).replace(/^(\.\.[\/\\])+/, "");
  if (path.isAbsolute(cleanPath) && fs.existsSync(cleanPath)) {
    return cleanPath;
  }
  const fromBase = path.resolve(baseDir, cleanPath);
  if (fs.existsSync(fromBase)) {
    return fromBase;
  }
  const fromRoot = path.resolve("/", cleanPath);
  if (fs.existsSync(fromRoot)) {
    return fromRoot;
  }
  return fromBase;
}

// Upload
app.all(["/control/upload", "/control/upload/"], (req, res) => {
  if (req.method === "GET") {
    return res.type("html").send("<html>Upload Web UI</html>");
  }
  if (req.method === "PUT") {
    let rawPath = req.query.path || req.query.dest || req.headers["x-file-path"] || "";
    if (!rawPath && req.query.filename) {
      const dir = req.query.dir || WORK_DIR;
      rawPath = path.join(dir, req.query.filename);
    }
    if (!rawPath && req.headers["x-file-name"]) {
      rawPath = path.join(WORK_DIR, req.headers["x-file-name"]);
    }
    rawPath = String(rawPath).trim();
    if (!rawPath) {
      return res.status(400).type("text/plain").send("Missing target file path\n");
    }
    let targetPath = path.isAbsolute(rawPath) ? path.normalize(rawPath) : path.resolve(WORK_DIR, rawPath);
    if (rawPath.endsWith("/") || (fs.existsSync(targetPath) && fs.statSync(targetPath).isDirectory())) {
      const fn = req.headers["x-file-name"] || req.query.filename || "uploaded_file";
      targetPath = path.join(targetPath, fn);
    }
    try {
      fs.mkdirSync(path.dirname(targetPath), { recursive: true });
    } catch(err) {
      return res.status(500).json({ ok: false, error: err.message });
    }
    const writeStream = fs.createWriteStream(targetPath);
    let totalBytes = 0;
    req.on("data", chunk => totalBytes += chunk.length);
    req.pipe(writeStream);
    writeStream.on("finish", () => {
      const dlPath = targetPath.startsWith("/") ? targetPath.substring(1) : targetPath;
      res.status(200).json({
        ok: true,
        path: targetPath,
        size: totalBytes,
        message: `File successfully uploaded to ${targetPath}`,
        downloadUrl: `/control/donwload/${dlPath}`
      });
    });
    writeStream.on("error", (err) => {
      if (!res.headersSent) res.status(500).json({ ok: false, error: err.message });
    });
    return;
  }
  res.status(405).type("text/plain").send(`Unsupported method ${req.method}\n`);
});

// Download
app.all(["/control/donwload/{*path}", "/control/download/{*path}"], (req, res) => {
  if (req.method !== "GET") {
    return res.status(405).type("text/plain").send(`Unsupported method ${req.method}\n`);
  }
  let relPath = Array.isArray(req.params.path) ? req.params.path.join("/") : (req.params.path || "");
  relPath = decodeURIComponent(relPath).trim();
  if (!relPath) {
    return res.status(400).type("text/plain").send("Missing file path\n");
  }
  const targetFile = resolveDownloadPath(relPath, WORK_DIR);
  if (!fs.existsSync(targetFile)) {
    return res.status(404).type("text/plain").send(`File not found: ${relPath}\n`);
  }
  if (fs.statSync(targetFile).isDirectory()) {
    return res.status(400).type("text/plain").send(`Target path is a directory: ${relPath}\n`);
  }
  res.download(targetFile);
});

app.all(["/control/donwload", "/control/donwload/", "/control/download", "/control/download/"], (req, res) => {
  res.status(400).type("text/plain").send("Missing file path. Usage: /control/donwload/<path>\n");
});

const server = app.listen(0, async () => {
  const port = server.address().port;
  const baseUrl = `http://localhost:${port}`;

  // 1. GET /control/upload
  const r1 = await fetch(`${baseUrl}/control/upload`);
  console.log("1. GET /control/upload:", r1.status);

  // 2. PUT /control/upload
  const r2 = await fetch(`${baseUrl}/control/upload?path=/tmp/webterm_test_agy/sub/nested/file.txt`, {
    method: "PUT",
    body: "Antigravity Content 12345"
  });
  const data2 = await r2.json();
  console.log("2. PUT /control/upload:", r2.status, data2);

  // 3. GET /control/donwload/<path>
  const r3 = await fetch(`${baseUrl}/control/donwload/sub/nested/file.txt`);
  console.log("3. GET /control/donwload/sub/nested/file.txt:", r3.status, await r3.text());

  // 4. GET /control/download/<path>
